[node name="LeftTitle" parent="Pages/GrimoirePage3" index="5" unique_id=339167460]
text = "Element: Fire

Astrology: Sagittarius 
(seeking, exploration, 
and philosophical balance)"

[node name="LeftDescription" parent="Pages/GrimoirePage3" index="6" unique_id=1512466279]
text = "              Divine balance and the peaceful 
               integration of opposites. 
          Temperance calls upon the traveler to 
walk the golden middle path, carefully 
blending the contrasting currents of emotion 
and logic into a stable, harmonious flow."

[node name="RightTitle" parent="Pages/GrimoirePage3" index="7" unique_id=1071230051]
offset_left = 1151.0
offset_right = 1551.0
text = "Element: Water

Astrology: Pisces (dreams, 
illusion, and the deep 
subconscious)
"

[node name="RightDescription" parent="Pages/GrimoirePage3" index="8" unique_id=275314100]
text = "Shifting illusions and navigating the ink-black 
 depths of the subconscious mind. Under the 
fickle glow of the Moon, the mind easily paints 
monsters out of dust motes. Peer past 
deceptive facades and realize the demons you 
  fear are often just shadows."

[node name="GrimoirePage4" parent="Pages" unique_id=1277763301 instance=ExtResource("3_46r2j")]
visible = false
layout_mode = 1
left_tooltip_text = "You must harvest the golden blossom of summer and place it safely inside the summer’s eye."
right_tooltip_text = "You must lure the guardians away with the bait of the pond in order to claim the buried key. Monarch, sentinels, checkmate, moves"
left_card_index = 6
right_card_index = 7

