[node name="LeftTitle" parent="Pages/GrimoirePage2" index="5" unique_id=339167460]
text = "Element: Air

Astrology: Aquarius 
(vision, hope, community, 
and the future)"

[node name="LeftDescription" parent="Pages/GrimoirePage2" index="6" unique_id=1512466279]
text = "                 A downpour of hope and a serene, 
                 guiding starlight blinking through 
                the clouds after a thundering storm. 
It brings a velvet blanket of calm directly 
                            from the cosmos, signaling 
                              that wounds are knitting 
                               together and the horizon is 
                               safe to trust once more."

[node name="RightTitle" parent="Pages/GrimoirePage2" index="7" unique_id=1071230051]
text = "Element: Water

Astrology: Scorpio 
(rebirth, deep 
psychological truth, 
and transformation)
"

[node name="RightDescription" parent="Pages/GrimoirePage2" index="8" unique_id=275314100]
text = "Grand transformation and major, sweeping 
  transitions. This somber card rarely 
foretells physical demise; instead, it sings of 
the definitive, cosmic snapping shut of one door 
so that an entirely new, glorious portal may 
   swing wide."

[node name="GrimoirePage3" parent="Pages" unique_id=972283493 instance=ExtResource("3_46r2j")]
visible = false
layout_mode = 1
left_tooltip_text = "You must find the scattered runes across the room, letting the dots guide each rune to its proper place. To claim the card, you must practice true alchemy and place the weighted sacks upon the pans in absolute equilibrium"
right_tooltip_text = "Two fractured relics of silver must be woven back into a singular embrace, for only when they unite shall the glorious splendor of the full moon finally cast its light."
left_card_index = 4
right_card_index = 5

