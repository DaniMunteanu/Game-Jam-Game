[node name="GrimoirePage1" parent="Pages" unique_id=2121197119 instance=ExtResource("3_46r2j")]
layout_mode = 1
left_tooltip_text = "The sacred elements have fallen into a state of chaotic disarray, and you must restore them to their rightful order before the true path will reveal itself."
right_tooltip_text = "The liquid elixirs must mimic the colorful garments of the books upon the library shelves."

[node name="CardRight" parent="Pages/GrimoirePage1" index="2" unique_id=1079632786]
texture = ExtResource("12_qertg")

[node name="LeftTitle" parent="Pages/GrimoirePage1" index="5" unique_id=339167460]
text = "Element: Air

Astrology: Mercury 
(communication, 
intellect, and 
resourcefulness)"

[node name="LeftDescription" parent="Pages/GrimoirePage1" index="6" unique_id=1512466279]
text = "Manifestation, sharp willpower, and glorious 
capability. The Magician stands as a bridge 
between intent and reality, signaling that the 
seeker possesses every curious tool required 
to transmute an ordinary idea into spectacular 
                        success through deliberate, 
                        everyday alchemy."
label_settings = SubResource("LabelSettings_qa2i4")

[node name="RightTitle" parent="Pages/GrimoirePage1" index="7" unique_id=1071230051]
text = "Element: Earth

Astrology: Taurus 
(stability, persistence, 
and deeply rooted values)
"

[node name="RightDescription" parent="Pages/GrimoirePage1" index="8" unique_id=275314100]
offset_left = 981.0
offset_right = 1401.0
offset_bottom = 685.0
text = "Sacred tradition and the comfortable 
architecture of established beliefs. 
The Hierophant represents the wisdom of 
              working within time-honored 
            frameworks or seeking the mentorship 
 of ancient, dusty scrolls and well-tested 
sages."

[node name="GrimoirePage2" parent="Pages" unique_id=450620601 instance=ExtResource("3_46r2j")]
visible = false
layout_mode = 1
left_tooltip_text = "You must connect the scattered stars to reveal the hidden constellation, then find its shape upon the wheel."
right_tooltip_text = "You must listen closely to the drifting whispers of the spirit board."
left_card_index = 2
right_card_index = 3

